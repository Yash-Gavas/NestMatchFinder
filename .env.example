# Copy this file to .env and fill in values.
# NEVER commit .env to git.

# PostgreSQL (use Neon for online/production: https://neon.tech)
# Example Neon URL:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/nestmatch_db

# JWT secret for auth tokens (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_string

# Resend (https://resend.com) — required for OTP emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: verified sender. Default uses Resend onboarding address.
# RESEND_FROM_EMAIL=NestMatch <onboarding@resend.dev>
# After you verify your domain in Resend, use e.g.:
# RESEND_FROM_EMAIL=NestMatch <noreply@yourdomain.com>

# Node environment
NODE_ENV=development
